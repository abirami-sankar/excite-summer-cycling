__pycache__/
*.pyc
.pytest_cache/
output/
run.jsonl
*.jsonl

# Large source media — present locally, NOT pushed (GitHub's 100 MB/file limit;
# these are up to 1.2 GB). Get them from the shared drive / archived original
# and drop into data/training/.  (data/training/README.md IS tracked.)
data/training/*.mp4
data/training/*.mov

# stray local screen-recordings dropped at the repo root
/*.mp4
/*.mov

# demo_voices/ is SHARED test data for the gaze study -- always tracked, so
# anyone who pulls can run the playback. Keep this LAST so no pattern above
# (or a future *.mp3 / *.wav rule) can hide it. Keep clips small (<100 MB each).
!demo_voices/
!demo_voices/**
